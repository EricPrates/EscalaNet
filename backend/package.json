{
  "name": "escalanet",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migrate:generate": "npm run typeorm -- migration:generate -d data-source.ts",
    "migrate:run": "npm run typeorm -- migration:run -d data-source.ts",
    "migrate:revert": "npm run typeorm -- migration:revert -d data-source.ts",
    "dev": "nodemon src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "seed:admin": "ts-node src/scripts/criarUsuarioAdmin.ts",
    "seed:nucleos": "ts-node src/scripts/criarNucleos.ts",
    "test:unit": "jest --testPathPattern=__tests__",
    "test-db": "ts-node -e \"require('./src/data-source').AppDataSource.initialize().then(() => console.log('Conectado!')).catch(console.error)\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EricPrates/EscalaNet.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/EricPrates/EscalaNet/issues"
  },
  "homepage": "https://github.com/EricPrates/EscalaNet#readme",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/puppeteer": "^7.0.4",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "handlebars": "^4.7.9",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.22.0",
    "puppeteer": "^25.1.0",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^6.0.1",
    "typeorm": "^1.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  }
}
