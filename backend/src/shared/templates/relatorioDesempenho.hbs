<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Relatório de Desempenho</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Helvetica', Arial, sans-serif;
            font-size: 12px;
            padding: 40px;
            color: #333;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #1a5276;
            padding-bottom: 20px;
        }
        .header h1 {
            color: #1a5276;
            font-size: 24px;
        }
        .header p {
            color: #666;
            font-size: 14px;
            margin-top: 5px;
        }
        .info {
            display: flex;
            justify-content: space-between;
            background: #f8f9fa;
            padding: 15px 20px;
            border-radius: 6px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }
        .info-item {
            margin: 5px 10px 5px 0;
        }
        .info-item strong {
            color: #1a5276;
        }
        .stats-summary {
            display: flex;
            gap: 30px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }
        .stat-card {
            background: #f8f9fa;
            padding: 15px 25px;
            border-radius: 8px;
            text-align: center;
            flex: 1;
            min-width: 120px;
            border-left: 4px solid #1a5276;
        }
        .stat-card .number {
            font-size: 28px;
            font-weight: bold;
            color: #1a5276;
        }
        .stat-card .label {
            font-size: 11px;
            color: #666;
            margin-top: 4px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        th {
            background: #1a5276;
            color: white;
            padding: 10px 12px;
            text-align: left;
            font-weight: 600;
        }
        td {
            padding: 8px 12px;
            border-bottom: 1px solid #ddd;
        }
        tr:nth-child(even) {
            background: #f8f9fa;
        }
        .gols { color: #27ae60; font-weight: bold; }
        .cartoes { color: #e74c3c; }
        .footer {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            text-align: center;
            color: #999;
            font-size: 11px;
        }
        @media print {
            body { padding: 20px; }
            .info { background: #f0f0f0; }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>⚽ Relatório de Desempenho</h1>
        <p>Sistema EscalaNet - Gerado em {{dataGeracao}}</p>
    </div>

    <div class="info">
        <div class="info-item"><strong>Período:</strong> {{periodo.inicio}} a {{periodo.fim}}</div>
        {{#if nucleo}}
        <div class="info-item"><strong>Núcleo:</strong> {{nucleo.nome}}</div>
        {{/if}}
        {{#if time}}
        <div class="info-item"><strong>Time:</strong> {{time.nome}}</div>
        {{/if}}
    </div>

    <div class="stats-summary">
        <div class="stat-card">
            <div class="number">{{totalJogos}}</div>
            <div class="label">Total de Jogos</div>
        </div>
        <div class="stat-card">
            <div class="number">{{totalGols}}</div>
            <div class="label">Gols Marcados</div>
        </div>
        <div class="stat-card">
            <div class="number">{{jogadores.length}}</div>
            <div class="label">Jogadores Envolvidos</div>
        </div>
    </div>

    <h3 style="margin: 20px 0 10px 0; color: #1a5276;">Desempenho por Jogador</h3>
    <table>
        <thead>
            <tr>
                <th>Jogador</th>
                <th>Time</th>
                <th>Jogos</th>
                <th>Gols</th>
                <th>Faltas</th>
                <th>Cartões Amarelos</th>
                <th>Cartões Vermelhos</th>
                <th>Substituições</th>
                <th>Escanteios</th>
            </tr>
        </thead>
        <tbody>
            {{#each jogadores}}
            <tr>
                <td><strong>{{this.jogadorNome}}</strong></td>
                <td>{{this.timeNome}}</td>
                <td>{{this.totalJogos}}</td>
                <td class="gols">{{this.gols}}</td>
                <td>{{this.faltas}}</td>
                <td class="cartoes">{{this.cartoesAmarelos}}</td>
                <td class="cartoes">{{this.cartoesVermelhos}}</td>
                <td>{{this.substituicoes}}</td>
                <td>{{this.escanteios}}</td>
            </tr>
            {{else}}
            <tr><td colspan="9" style="text-align: center; padding: 30px; color: #999;">Nenhum dado encontrado</td></tr>
            {{/each}}
        </tbody>
    </table>

    <div class="footer">
        <p>Relatório gerado automaticamente pelo EscalaNet em {{dataGeracao}}</p>
        <p>EscalaNet - Sistema de Gestão Esportiva</p>
    </div>
</body>
</html>