<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Relatório de Frequência</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Helvetica', Arial, sans-serif;
            font-size: 12px;
            padding: 40px;
            color: #333;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #1a5276;
            padding-bottom: 20px;
        }
        .header h1 {
            color: #1a5276;
            font-size: 24px;
        }
        .header p {
            color: #666;
            font-size: 14px;
            margin-top: 5px;
        }
        .info {
            display: flex;
            justify-content: space-between;
            background: #f8f9fa;
            padding: 15px 20px;
            border-radius: 6px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }
        .info-item {
            margin: 5px 10px 5px 0;
        }
        .info-item strong {
            color: #1a5276;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        th {
            background: #1a5276;
            color: white;
            padding: 10px 12px;
            text-align: left;
            font-weight: 600;
        }
        td {
            padding: 8px 12px;
            border-bottom: 1px solid #ddd;
        }
        tr:nth-child(even) {
            background: #f8f9fa;
        }
        .presenca-alta {
            color: #27ae60;
            font-weight: bold;
        }
        .presenca-media {
            color: #f39c12;
            font-weight: bold;
        }
        .presenca-baixa {
            color: #e74c3c;
            font-weight: bold;
        }
        .footer {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            text-align: center;
            color: #999;
            font-size: 11px;
        }
        .badge {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: bold;
        }
        .badge-treino { background: #3498db; color: white; }
        .badge-jogo { background: #e67e22; color: white; }
        .faltas-list {
            font-size: 11px;
            color: #666;
            margin-top: 3px;
        }
        .faltas-list span {
            display: inline-block;
            margin-right: 8px;
        }
        .page-break {
            page-break-after: always;
        }
        @media print {
            body { padding: 20px; }
            .info { background: #f0f0f0; }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>📊 Relatório de Frequência</h1>
        <p>Sistema EscalaNet - Gerado em {{dataGeracao}}</p>
    </div>

    <div class="info">
        <div class="info-item"><strong>Período:</strong> {{periodo.inicio}} a {{periodo.fim}}</div>
        {{#if nucleo}}
        <div class="info-item"><strong>Núcleo:</strong> {{nucleo.nome}}</div>
        {{/if}}
        {{#if time}}
        <div class="info-item"><strong>Time:</strong> {{time.nome}}</div>
        {{/if}}
        <div class="info-item"><strong>Total de Chamadas:</strong> {{totalChamadas}}</div>
        <div class="info-item"><strong>Média de Presença:</strong> {{mediaPresenca}}%</div>
    </div>

    <h3 style="margin: 20px 0 10px 0; color: #1a5276;">Presença por Jogador</h3>
    <table>
        <thead>
            <tr>
                <th>Jogador</th>
                <th>Time</th>
                <th>Chamadas</th>
                <th>Presenças</th>
                <th>Faltas</th>
                <th>% Presença</th>
                <th>Detalhes</th>
            </tr>
        </thead>
        <tbody>
            {{#each jogadores}}
            <tr>
                <td><strong>{{this.jogadorNome}}</strong></td>
                <td>{{this.timeNome}}</td>
                <td>{{this.totalChamadas}}</td>
                <td>{{this.totalPresencas}}</td>
                <td>{{this.totalFaltas}}</td>
                <td>
                    <span class="
                        {{#if (gt this.percentualPresenca 80)}}presenca-alta{{/if}}
                        {{#if (and (gte this.percentualPresenca 60) (lte this.percentualPresenca 80))}}presenca-media{{/if}}
                        {{#if (lt this.percentualPresenca 60)}}presenca-baixa{{/if}}
                    ">
                        {{this.percentualPresenca}}%
                    </span>
                </td>
                <td>
                    {{#if this.faltas.length}}
                    <div class="faltas-list">
                        {{#each this.faltas}}
                        <span>
                            <span class="badge badge-{{this.tipo}}">{{this.tipo}}</span>
                            {{this.data}}
                            {{#if this.justificativa}} - {{this.justificativa}}{{/if}}
                        </span>
                        {{/each}}
                    </div>
                    {{else}}
                    <span style="color: #27ae60;">✓ Sem faltas</span>
                    {{/if}}
                </td>
            </tr>
            {{else}}
            <tr><td colspan="7" style="text-align: center; padding: 30px; color: #999;">Nenhum jogador encontrado neste período</td></tr>
            {{/each}}
        </tbody>
    </table>

    <div class="footer">
        <p>Relatório gerado automaticamente pelo EscalaNet em {{dataGeracao}}</p>
        <p>EscalaNet - Sistema de Gestão Esportiva</p>
    </div>
</body>
</html>